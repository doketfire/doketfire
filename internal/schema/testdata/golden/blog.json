{
  "version": 1,
  "project": "blog",
  "tables": [
    {
      "name": "comments",
      "fields": [
        {
          "name": "post_id",
          "type": "uuid",
          "required": true,
          "ref": {
            "table": "posts",
            "field": "id",
            "on_delete": "SET NULL"
          }
        },
        {
          "name": "body",
          "type": "text",
          "required": true
        },
        {
          "name": "author_id",
          "type": "uuid",
          "ref": {
            "table": "_dk_users",
            "field": "id",
            "on_delete": "SET NULL"
          }
        }
      ],
      "indexes": [
        {
          "name": "idx_comments_post_id_created_at",
          "fields": [
            {
              "name": "post_id"
            },
            {
              "name": "created_at"
            }
          ]
        }
      ],
      "permissions": {
        "create": "request.auth != null",
        "list": "true",
        "read": "true"
      }
    },
    {
      "name": "posts",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true,
          "min": 1,
          "max": 200
        },
        {
          "name": "slug",
          "type": "text",
          "required": true,
          "unique": true,
          "pattern": "^[a-z0-9-]+$"
        },
        {
          "name": "body",
          "type": "text"
        },
        {
          "name": "published",
          "type": "boolean",
          "default": false
        },
        {
          "name": "author_id",
          "type": "uuid",
          "ref": {
            "table": "_dk_users",
            "field": "id",
            "on_delete": "SET NULL"
          }
        },
        {
          "name": "status",
          "type": "enum",
          "enum": [
            "draft",
            "published"
          ]
        },
        {
          "name": "metadata",
          "type": "json",
          "json_schema": "{\"type\":\"object\"}"
        }
      ],
      "indexes": [
        {
          "name": "idx_posts_published_created_at",
          "fields": [
            {
              "name": "published"
            },
            {
              "name": "created_at"
            }
          ]
        },
        {
          "name": "posts_slug_idx",
          "fields": [
            {
              "name": "slug"
            }
          ],
          "unique": true
        },
        {
          "name": "idx_posts_author_id",
          "fields": [
            {
              "name": "author_id"
            }
          ],
          "where": "published = 1"
        }
      ],
      "permissions": {
        "create": "request.auth != null",
        "delete": "request.auth != null && request.auth.role == 'admin'",
        "list": "resource.published == true",
        "read": "resource.published == true",
        "update": "request.auth != null && request.auth.id == resource.author_id"
      },
      "realtime": true
    },
    {
      "name": "profiles",
      "fields": [
        {
          "name": "email",
          "type": "text",
          "required": true,
          "unique": true
        },
        {
          "name": "name",
          "type": "text"
        }
      ]
    }
  ]
}
