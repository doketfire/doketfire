# Normalize line endings: LF in the repository and working tree.
# Windows scripts keep CRLF so they run natively.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.exe binary
*.db binary
